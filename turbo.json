{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#watch": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build", "//#build"],
      "outputs": ["dist/**"]
    },
    "//#build": {
      "outputs": ["dist/**"]
    },
    "lint": {},
    "//#lint": {},
    "preview": {
      "persistent": true,
      "cache": false
    }
  }
}
