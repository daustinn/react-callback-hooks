---
import Root from '#/layouts/root.astro'
import { getNode, getSlugs } from 'slugtree'
import ArrowRight from '#/assets/arrow-right.svg'
import MdxRenderer from '#/components/mdx/renderer.astro'

export function getStaticPaths() {
  return getSlugs().map((slug) => ({
    params: {
      path: slug.join('/')
    },
    props: {
      slug
    }
  }))
}

const { slug } = Astro.props

const node = getNode(slug)
---

<Root
  title={node?.title}
  description={node?.description}
  canonicalPath={`/${slug.join('/')}`}
>
  {
    node ? (
      <main class="grow container flex flex-col">
        <nav class="py-2 sticky top-0 bg-background z-10">
          <a
            href="/"
            class="flex font-semibold text-sm items-center group gap-2 hover:opacity-70"
          >
            <ArrowRight
              width={15}
              class="rotate-180 transition-[translate] group-hover:-translate-x-1"
            />
            Back to Home
          </a>
        </nav>
        <section class="pt-2 flex grow flex-col">
          <header>
            <h1 class="text-4xl font-neuton mb-2">{node?.title}</h1>
            <p>{node?.description}</p>
          </header>
          <div class="prose__content grow pt-6">
            <MdxRenderer node={node} />
          </div>
        </section>
      </main>
    ) : (
      <p>Page not found</p>
    )
  }
</Root>
