---
import Footer from '#/components/footer.astro'
import Header from '#/components/header.astro'
import seo from '#/const/seo'

import '#/styles/global.css'

export type Props = {
  title?: string
  description?: string
  canonicalPath?: string
}

const {
  title = seo.title,
  description = seo.description,
  canonicalPath
} = Astro.props

const pageTitle =
  title === seo.title ? `${seo.name} — ${title}` : `${title} — ${seo.name}`

const canonicalUrl = canonicalPath
  ? `${seo.siteUrl}${canonicalPath}`
  : `${seo.siteUrl}${Astro.url.pathname}`

const ogImage = `${seo.siteUrl}/android-chrome-512x512.png`

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: seo.name,
  description: seo.description,
  url: seo.siteUrl,
  codeRepository: 'https://github.com/daustinn/react-callback-hooks',
  programmingLanguage: 'TypeScript',
  runtimePlatform: 'React',
  license: 'https://opensource.org/licenses/MIT',
  keywords: seo.keywords,
  author: {
    '@type': 'Person',
    name: 'Daustinn',
    url: 'https://daustinn.com'
  }
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Fonts -->
    <link
      rel="preload"
      href="/neuton-light.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/neuton-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/neuton-bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/neuton-extrabold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Primary SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={seo.keywords} />
    <meta name="author" content="Daustinn" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={seo.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content={`${seo.name} logo`} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content={seo.twitterHandle} />
    <meta name="twitter:creator" content={seo.twitterHandle} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${seo.name} logo`} />

    <!-- Favicons & PWA -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-svh flex flex-col">
    <Header />
    <slot />
    <Footer />
  </body>
</html>
